# --- secrets (never commit) ---
.env
*.env
!.env.example
openrouter-key.env

# --- runtime / logs ---
*.log
logs/
decisions*.jsonl

# --- deps / build ---
node_modules/
dist/
.devbox/
.direnv/

# --- os ---
.DS_Store

# SDD scratch (ledger)
.superpowers/

# ESLint cache
.eslintcache

# Fieldbook writes pre-merge originals here before touching a file. Local safety
# net for an install/upgrade; redundant once the merged result is committed.
.kit-backups/

# Claude Code: settings.json IS tracked — it carries the Fieldbook hook registrations
# and permission allowlist, which must travel with a clone or the enforcement layer
# silently does not exist (every path in it is ${CLAUDE_PROJECT_DIR}-relative, no secrets).
# settings.local.json stays personal: machine-absolute paths, per-operator allowances.
.claude/settings.local.json

# /handoff archives the previous session bridge here before regenerating it. Local
# session state, same class as .kit-backups/ — and it accumulates verbatim operator
# session notes, which are exactly the thing that should not land in a public repo
# by way of a stray `git add -A`. The live bridge is .agent-docs/now/handoff.md.
.claude/handoffs/
